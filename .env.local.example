# Neon Postgres connection string (server-only — never expose to the browser)
# Use the pooled connection string from the Neon console.
# Example:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Google OAuth for school Workspace accounts (@yeonsung.ac.kr)
# Create an OAuth 2.0 Web client in Google Cloud Console.
# Authorized redirect URI must be exactly:
#   {origin}/api/auth/google/callback
# Local example: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HMAC secret for the qrious_google session cookie (random 32+ bytes)
AUTH_SECRET=

# Optional public origin when behind a proxy or custom domain.
# If empty, the request Host / x-forwarded-* headers are used.
# AUTH_URL=https://your-domain.example
AUTH_URL=
