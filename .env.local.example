# Aurora PostgreSQL (server-only — never expose to the browser)
# Writer endpoint: inserts/updates/deletes and reads that must see just-written data.
AURORA_WRITER_ENDPOINT=
# Reader endpoint: read-only queries (falls back to the writer if empty).
AURORA_READER_ENDPOINT=
AURORA_DB_USER=
AURORA_DB_PASSWORD=
AURORA_DB_NAME=
AURORA_DB_PORT=5432
# Optional: max connections per pool per server instance (default 5).
# AURORA_POOL_MAX=5
# Optional: AURORA_DB_SSL=disable turns SSL off. AURORA_DB_SSL_CA (PEM text or file path)
# enables certificate verification. By default SSL is on without certificate verification.
# AURORA_DB_SSL_CA=

# Only needed to run scripts/migrate-neon-to-aurora.mjs (source database, read-only).
# DATABASE_URL=

# HMAC secret for the qrious_session cookie (random 32+ bytes)
AUTH_SECRET=

# Optional comma-separated admin phone numbers (digits or 010-1234-5678).
# Admins can also be stored in the admin.phone column.
# ADMIN_PHONES=01012345678

# Optional public origin when behind a proxy or custom domain.
# If empty, the request Host / x-forwarded-* headers are used.
# AUTH_URL=https://your-domain.example
AUTH_URL=
